# Environment for the full-stack E2E suite. Points at the throwaway stack from
# docker-compose.e2e.yml (shifted ports, so it never touches the dev stack).
# Loaded by playwright.config.ts — do not source it for normal development.

DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=koop
DB_PASSWORD=koop
DB_DATABASE=kooperative

# Throwaway secret — this database is wiped before every run.
SESSION_SECRET=e2e-only-secret-not-used-anywhere-else-0123456789

SMTP_HOST=127.0.0.1
SMTP_PORT=1026
SMTP_SECURE=false
MAIL_FROM=shop@example.org
MAIL_OPERATOR=betrieb@example.org

# The suite drives the shop on 3100 so it can run next to a dev server on 3000.
PUBLIC_BASE_URL=http://127.0.0.1:3100
ADMIN_BASE_URL=http://127.0.0.1:3100/admin

ALLOW_DB_WRITES=true
ADMIN_USERS=e2e-admin:e2e-admin-password
